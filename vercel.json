{
  "version": 2,
  "builds": [
    {
      "src": "README.md",
      "use": "@vercel/mdx"
    },
    {
      "src": "styles.css",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*).css",
      "dest": "/styles.css"
    },
    {
      "src": "/(.*)",
      "dest": "/README.md"
    }
  ]
}